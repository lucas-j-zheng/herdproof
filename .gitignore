# The browser demo needs its small exported detector.
!/website/public/demo/model/*.onnx

# Validation mixes source with large/private generated experiments.
# Publish its docs, protocols, review tools, and reusable viewer source.
/validation/*
!/validation/*.md
!/validation/*.json
!/validation/example-inventory.csv
!/validation/review.html
!/validation/marker-tools.js
!/validation/world-viewer/
!/validation/terrain-demo/
/validation/terrain-demo/*
