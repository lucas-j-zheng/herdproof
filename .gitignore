.venv/
.cache/
__pycache__/
*.pyc
validation/data/
validation/models/
validation/review-assets/
validation/sessions/
validation/runs/
validation/train-data/
validation/calibration-sanity.json
validation/*.log

# Publish only the runnable training package. Research and local artifacts stay private.
/*
!/.gitignore
!/training/
/training/*
!/training/*.py
!/training/*.json
!/training/environment/
/training/environment/*
!/training/environment/pyproject.toml
!/training/environment/uv.lock
!/training/environment/requirements-cu126.lock
!/training/slurm/
/training/slurm/*
!/training/slurm/*.sh

# Never publish prose notes, data, credentials, or generated model artifacts.
**/*.[mM][dD]
**/*.rst
**/*.ipynb
**/.env*
**/__pycache__/
**/*.pt
**/*.png
**/*.jpg
**/*.zip
